# cPanel target: arifbillah.com. Fill in the real cPanel database and SMTP values.
APP_NAME="Arif Portfolio"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
SITE_INDEXABLE=false
APP_URL=https://arifbillah.com
APP_TIMEZONE=Asia/Dhaka
# Leave empty when the domain serves this application's public/ directory.
# For a fixed cPanel public_html, set its full path and use public_html-index.php.
APP_PUBLIC_PATH=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CPANEL_USER_portfolio
DB_USERNAME=CPANEL_USER_portfolio
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true
TRUSTED_PROXIES=

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
# Use the SMTP details supplied by your hosting or email provider.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Arif Portfolio"
